clc; close all; clear;
%% Input Data: parameters are changed one at a time
% design variables
W2S=[600]'; % [kg/m^2]
M_cruise=[0.76]';
t2c=[0.10]';
AR=[10]'; % aspect ratio
taper_ratio=[0.25]'; % taper ratio
sweep_angle=deg2rad([20])'; % sweep angle
N=2; % number of engines

% requirments
N_pass=148;
range=5.89*10^6; % [m]


CL_design=0.3; % CL considering as design point 25% of cruise distance, evaluating W_design
MTOW0=73.5*10^3; % [Kg]

% airport Parameters
altitude_airport=0;
rho_airport=1.225;
T_airport=288.15;
p_airport=101325;

% cruise condition
altitude_cruise=10000; % [m]

%% Functions recall
% MTOW0=Raymer_weight_evaluation(N_pass);

[V_cruise,T2W] = ...
    matching_chart(N,MTOW0,W2S,sweep_angle,rho_airport, M_cruise,altitude_cruise,T_airport);

[Cd0_tot,Cd0_wing,Cd0_horizontal,Cd0_vertical,Cd0_fusolage,Cd0_nacelle,e,M_crit,Cd_wave,S,Cd_i,b] = ...
    aerodynamics(M_cruise,W2S,MTOW0,T2W,AR,taper_ratio,sweep_angle,t2c,CL_design,V_cruise,N);

[M_wing] = weights(AR,MTOW0,taper_ratio,W2S,t2c,sweep_angle);
