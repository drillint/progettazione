clc; close all; clear;
%% Input:
% design variables
N_vec=[2,4]; % numero di motori
W2S_vec=[550,650]; % [kg/m^2]
M_cruise_vec=[0.76,0.79,0.82]; % Mach di crociera
t2c_vec=[0.10,0.12]; % spessore dell'ala
AR_vec=[7,10,12]; % aspect ratio
taper_ratio_vec=[0.2,0.4]; % taper ratio
sweep_angle_vec=deg2rad([15,25,35]); % sweep angle

% requirments
N_pass=148;
range=5.89e6; % [m]

% condizioni aeroportuali(aeroporto a sea level)
altitude_airport=0;
rho_airport=1.225;
T_airport=288.15;
p_airport=101325;

% quota di design
altitude_cruise=11000; % [m]

%% Preparazione pre-loop
numit=0;
% stima iniziale e pesi alla Raymer
[MTOW0,Wfuel2WTO,Wblockfuel2WTO,W_payload,W_cargo,n_fa]= ...
    Raymer_weight_evaluation(N_pass,range);

% fusoliera
[df,Lf,N_container] = ...
    fuselage(N_pass);

%% Preallocazione della matrice delle configurazioni
% Numero di combinazioni
num_rows = numel(N_vec)*numel(W2S_vec)*numel(M_cruise_vec)*numel(t2c_vec)*numel(AR_vec)*numel(taper_ratio_vec)*numel(sweep_angle_vec);

% Numero di colonne
num_cols = 26; 

ConfigMatrix = zeros(num_rows, num_cols);
row_counter = 1;

%% Loop alla Raymer, per tutte le possibili configurazioni di design variables
for N = N_vec
    for W2S = W2S_vec
        for M_cruise = M_cruise_vec
            for t2c = t2c_vec
                for AR = AR_vec
                    for taper_ratio = taper_ratio_vec
                        for sweep_angle = sweep_angle_vec
                            % input(condizioni iniziali) per il loop 
                            k=0.04; Cd0=0.025;
                            MTOW=MTOW0; MTOW_gap=1000;
                            while abs(MTOW_gap) > 100
                                W_fuel=Wfuel2WTO*MTOW;
                                % propulsione
                                [rho_cruise,V_cruise,T2W,W2S_lim] = ...
                                    matching_chart(N,MTOW,W2S,sweep_angle,rho_airport, M_cruise,altitude_cruise,T_airport,k,Cd0);

                                % CL_design, tra gli input dell'aerodinamica
                                W25=MTOW-0.25*W_fuel;
                                CL_design= 2*W2S/MTOW*W25*9.81/(rho_cruise*V_cruise^2);

                                % aerodinamica
                                [Cd0_star,e,M_crit,Cd_wave,S,S_wet_wing,Cd_i,b,E,k_star] = ...
                                    aerodynamics(M_cruise,W2S,MTOW,T2W,AR,taper_ratio,sweep_angle,t2c,CL_design,V_cruise,N,df,Lf);
                                    Cd=Cd0+Cd_i+Cd_wave;

                                % pesi
                                [OEW,W_wing,W_single_engine] = ...
                                    weights(N_pass,range,M_cruise,AR,MTOW,taper_ratio,W2S,t2c,sweep_angle,T2W,N,df,Lf,b,W_fuel);
                                MTOW_star=OEW+W_payload+W_cargo+W_fuel;

                                % calcolo il delta prima di aggiornare MTOW
                                MTOW_gap=MTOW_star-MTOW;

                                % i valori * rappresentano
                                % l'aggiornamento della variabile per il
                                % ciclo successivo. Per il blocco
                                % propulsivo serve un po' di aerodinamica
                                % (k, Cd0), che prendo dalla condizione di 
                                % input e poi dall'iterazione precedente
                                k=k_star;
                                Cd0=Cd0_star;

                                % aggiorno il peso
                                MTOW=MTOW_star;

                                numit=numit+1;
                            end
                            [m_bf,PREE,DOC,CF,CM]= ...
                                FoMs(MTOW,OEW,W_payload,W_fuel,range,Wblockfuel2WTO,N_pass,V_cruise,altitude_cruise,n_fa,N,W_single_engine,T2W);

                            %% Aggiungo la configurazione alla matrice
                            % Creazione delle strutture
                            DesignVars = struct('N', N, 't2c', t2c, 'AR', AR, 'taper_ratio', taper_ratio, ...
                                'sweep_angle', rad2deg(sweep_angle), 'W2S', W2S, 'M_cruise', M_cruise);

                            Geometry = struct('S', S, 'b', b, 'Swet', S_wet_wing);

                            Performance = struct('E', E, 'M', M_cruise, 'V_cruise', V_cruise,'Wfuel', W_fuel, 'Cdo', Cd0_star, 'Cdi', Cd_i, ...
                                'Cdwave', Cd_wave, 'Cdtot', Cd, 'CL_design', CL_design, 'T2W', T2W);

                            Weights = struct('MTOW', MTOW, 'OEW', OEW, 'Wwing', W_wing);

                            FOMs = struct('block_fuel', m_bf, 'PREE', PREE, 'DOC', DOC);

                            % Salvo la configurazione
                            ConfigMatrix(row_counter, :) = addConfiguration(DesignVars, Geometry, Performance, Weights,FOMs);
                            row_counter = row_counter + 1;

                        end
                    end
                end
            end
        end
    end
end
%% Visualizzazione della matrice delle configurazioni
disp(['Numero di configurazioni: ', num2str(num_rows)]);
% Nomi colonne
colNames = { ...
    'N','t2c','AR','TaperRatio','SweepAngle','W2S','M_cruise', ...
    'S','b','Swet', ...
    'E','M', 'Vcruise','Wfuel','Cdo','Cdi','Cdwave','Cdtot','CL_design','T2W', ...
    'MTOW','OEW','Wwing' ...
    'block_fuel', 'PREE', 'DOC'
    };
% Tabella MATLAB
ConfigTable = array2table(ConfigMatrix,'VariableNames',colNames);
disp(ConfigTable);

