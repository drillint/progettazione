% Wing
S=MTOW./W2S;
% formula in english units
Iw=@(AR,MTOW,taper_ratio,W2S,t2c,sweep_angle,W_fuel) 3.75*AR.^1.5.*((MTOW-W_fuel)./MTOW).^0.5...
    .*(1+2.*taper_ratio).*W2S.*S.^1.5*10.^-6./(t2c.*cos(sweep_angle).^2.*(1+taper_ratio));
% Wing load variations, according to aircraft category, always produce
% S>900 ft^2
W_wing=0.93*Iw(AR,MTOW*2.2,taper_ratio,W2S*0.2045,t2c,sweep_angle,20000*2.2)+6.44.*S.*2.2+390;
