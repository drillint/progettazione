function [Cd0_tot,e,M_crit,Cd_wave,S,Cd_i,b,E,k] = aerodynamics(M,W2S,MTOW,T2W,AR,taper_ratio,sweep_angle,t2c,CL_design,V_cruise,N,df,Lf) 
    % b eve essere al massimo 36 m per poter rientrare nelle piazzole C
    %% costants
    g=9.81;
   
    %% input
    chord=4.29; % mean aerodynamic chord of 737 [m], the following datas are set on 737 geometry
    horizontal_chord=6;
    vertical_chord=4.8;
    S_tail_horizontal2S=0.32; 
    S_tail_vertical2S=0.27;

    %% functions
    f_lambda=@(taper_ratio) 0.0524*taper_ratio.^4-0.15*taper_ratio.^3+...
        0.1659*taper_ratio.^2-0.0706*taper_ratio+0.0119;
    M_dd=@(t2c,CL_design,sweep_angle) 0.9./cos(sweep_angle)-t2c./(cos(sweep_angle).^2)-...
        0.1*CL_design/(cos(sweep_angle).^3);
    k=@(AR,e) 1./(pi*AR.*e);

    %% Aerodynamic parameters
    e=1./(1+f_lambda(taper_ratio).*AR).*cos(sweep_angle); % Ostwald factor, theorical formula
    M_crit=M_dd(t2c,CL_design,sweep_angle)-(0.1/80).^(1/3);
    Cd_wave=20*(M-M_crit).^4; % se M>M_critico
    S=MTOW./W2S; % reference surface
    Cd_i=k(AR,e)*CL_design^2;
    k=k(AR,e);
    b=(AR.*S).^(1/2); % wingspan
    % da contollare il valore di b, se maggiore di 36 m da scartare l'intera
    % configurazione per limitazioni sulle dimensioni della piazzola

    %% Aircraft polar curve
    % define functions for different contributions to Cd0 model

    % CF
    cf=@(Re,M) 0.455./(log10(Re).^2.58.*(1+0.144.*M.^2).^0.65); % equivalent friction coefficient
    % FF
    FF_wing=@(t2c,M,sweep_angle) (1+0.6/0.5*t2c+100*t2c.^4).*1.34.*M.^0.18.*cos(sweep_angle).^0.28; 
    FF_fuselage=@(l,A_max) 1+60/(l/sqrt(4/pi*A_max))^3+(l/sqrt(4/pi*A_max))/400; % form factor
    % Q(interference factor) is a costant, depends on structure type and position on the aircraft
    % S_wet
    S_wet_fuselage=@(A_top_fuselage,A_side_fuselage) 3.4*(A_top_fuselage+A_side_fuselage)/2;
    S_wet_wing=@(S_exposed,t2c) S_exposed*(1.997+0.52.*t2c);
    S_wet_nacelle=@(T_eng) 1./N.*pi*0.04*0.07*T_eng*0.3048^2; % Thrust of single engine, converted in [m^2]
    
    % Cd0 formula, valid for every structure. Cd0_TOT is the final sum
    Cd0=@(cf,FF,Q,S_wet,S) cf.*FF.*Q.*S_wet./S;

    % WINGS
    Cd0_wing=Cd0(cf(V_cruise*chord/(3.53*10^-5),M),FF_wing(t2c,M,sweep_angle),1,S_wet_wing(0.7*S,t2c),S);
    Cd0_horizontal=Cd0(cf(V_cruise*horizontal_chord/(3.53*10^-5),M),FF_wing(0.105,M,deg2rad(30)),1,...
        S_wet_wing(0.7*S_tail_horizontal2S*S,0.105),S);
    Cd0_vertical=Cd0(cf(V_cruise*vertical_chord/(3.53*10^-5),M),FF_wing(0.105,M,deg2rad(35)),1,...
        S_wet_wing(0.7*S_tail_vertical2S*S,0.12),S);

    % FUSELAGE
    Cd0_fusolage=Cd0(cf(V_cruise*35/(3.53*10^-5),M),FF_fuselage(Lf,pi*df^2),1,...
        S_wet_fuselage(0.9*Lf*df,0.85*Lf*df),S);

    % NACELLE (2 engines), FF for fuselage is used(cylinder body)
    Cd0_nacelle= N * Cd0(cf(V_cruise*3.5/(3.53*10^-5),M),FF_fuselage(3.5,2.27),1.3,S_wet_nacelle(T2W*MTOW*2.2),S);

    % TOTAL
    Cd0_tot=Cd0_wing+Cd0_horizontal+Cd0_vertical+Cd0_fusolage+Cd0_nacelle;
    Cd_tot=Cd0_tot+Cd_i+Cd_wave;
    E=CL_design/Cd_tot;
end
